<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github-uphoricstudios" value="https://nuget.pkg.github.com/uphoricstudios/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-uphoricstudios>
      <add key="Username" value="USERNAME" />
      <add key="ClearTextPassword" value="%UPHORIC_PACKAGES_TOKEN%" />
    </github-uphoricstudios>
  </packageSourceCredentials>
</configuration>
